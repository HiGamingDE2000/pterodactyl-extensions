{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "announcements",
    "name": "Announcements",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "Panel-wide announcement banners with colour types, validity windows, per-area targeting and per-user dismissal.",
    "author": "Anthony",
    "provider": "Announcements\\AnnouncementsProvider",
    "autoload": {
        "Announcements\\": "src"
    },
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "ann",
        "screens": [
            {
                "id": "announcements",
                "area": "admin",
                "path": "announcements",
                "nav": {
                    "label": "Announcements",
                    "icon": "megaphone"
                }
            }
        ]
    }
}
